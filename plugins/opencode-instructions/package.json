{
  "name": "@rozsazoltan/opencode-instructions",
  "version": "0.1.0",
  "description": "Merge explicit Markdown instruction sources into one OpenCode V2 system context block.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:gui": "vite build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.20",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opencode",
    "plugin",
    "instructions",
    "system-context"
  ]
}
