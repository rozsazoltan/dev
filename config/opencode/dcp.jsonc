{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "debug": false,
  "commands": {
    "enabled": true,
    "protectedTools": ["task_*", "wait_for_user"]
  },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "protectUserMessages": true,
    "protectedTools": ["task", "task_*", "skill", "todowrite", "todoread", "wait_for_user"]
  },
  "strategies": {
    "deduplication": { "enabled": true, "protectedTools": ["task_*", "wait_for_user"] },
    "purgeErrors": { "enabled": true, "turns": 4, "protectedTools": ["task_*", "wait_for_user"] }
  },
  "experimental": { "allowSubAgents": false, "customPrompts": false }
}
